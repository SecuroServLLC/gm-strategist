{
  "name": "PartyMember",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string",
      "description": "Referanse til Character hvis navngitt; null for frittst\u00e5ende brikke"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "character",
        "token"
      ],
      "default": "character",
      "description": "character = navngitt, token = fysisk brikke"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "animal",
        "beast",
        "humanoid",
        "undead",
        "construct",
        "critter",
        "flying",
        "enemy"
      ],
      "default": "animal",
      "description": "Brikke-type (vises med ikon p\u00e5 utskriftsark)"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "absent",
        "dead"
      ],
      "default": "active"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Antall brikker (for tokens)"
    },
    "current_hp": {
      "type": "number",
      "description": "N\u00e5v\u00e6rende HP under spilling"
    },
    "max_hp": {
      "type": "number",
      "description": "Maks HP"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rounds": {
            "type": "number",
            "description": "Gjenv\u00e6rende runder; 0 = permanent (teller ikke ned)"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "Aktive tilstander/effekter med nedtelling"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "current": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "Per-rest ressurser (ability charges); nullstilles ved kvile"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "name"
  ]
}