{
  "name": "Character",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "archetype": {
      "type": "string",
      "description": "Egendefinert arketype/profesjon"
    },
    "race": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "protagonist",
        "ally",
        "antagonist",
        "npc",
        "contact",
        "mentor"
      ],
      "default": "npc"
    },
    "background": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "description": "Seks attributter 1-20: kraft, smidighet, utholdenhet, intelligens, visdom, utstralning"
    },
    "hp": {
      "type": "number",
      "description": "Livspoeng"
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evner/profesjoner"
    },
    "appearance": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "secret_agenda": {
      "type": "string"
    },
    "portrait_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "relation": {
      "type": "string",
      "enum": [
        "friend",
        "neutral",
        "enemy"
      ],
      "default": "neutral",
      "description": "Gruppens forhold til denne NPC-en"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "closed",
        "open",
        "claimed"
      ],
      "default": "closed",
      "description": "closed=ikke valgbar, open=ledig, claimed=valgt"
    },
    "claimed_by": {
      "type": "string",
      "description": "Automatisk opprettet PartyMember-id"
    },
    "claim_device_id": {
      "type": "string",
      "description": "Terminalen som reserverte karakteren"
    }
  },
  "required": [
    "campaign_id",
    "name"
  ]
}