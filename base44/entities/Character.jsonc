{
  "name": "Character",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "archetype": {
      "type": "string",
      "description": "Egendefinert arketype/profesjon, f.eks. 'Bonde', 'Skyggevever'"
    },
    "race": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "protagonist",
        "ally",
        "antagonist",
        "npc",
        "contact",
        "mentor"
      ],
      "default": "npc"
    },
    "background": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "description": "Seks attributter 1-20: kraft, smidighet, utholdenhet, intelligens, visdom, utstralning"
    },
    "hp": {
      "type": "number",
      "description": "Livspoeng"
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evner/profesjoner \u2013 vises som opptil 3 linjer p\u00e5 utskriftsark"
    },
    "appearance": {
      "type": "string"
    },
    "hook": {
      "type": "string",
      "description": "Kobling til kampanjens r\u00f8de tr\u00e5d"
    },
    "secret_agenda": {
      "type": "string",
      "description": "Skjult m\u00e5l som utvikler seg uavhengig av spillerne"
    },
    "portrait_url": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "GM-notater"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "closed",
        "open",
        "claimed"
      ],
      "default": "closed",
      "description": "closed=ikke claimbar, open=ledig for spiller \u00e5 claime, claimed=allerede tatt"
    },
    "claimed_by": {
      "type": "string",
      "description": "PartyMember-id som har claimet karakteren"
    }
  },
  "required": [
    "campaign_id",
    "name"
  ]
}