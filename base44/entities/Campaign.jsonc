{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "premise": {
      "type": "string",
      "description": "Den r\u00f8de tr\u00e5den \u2013 hovedfortellingen som binder kampanjen sammen"
    },
    "setting": {
      "type": "string",
      "description": "Verden, tidsalder, geografi"
    },
    "tone": {
      "type": "string",
      "description": "Stemning: m\u00f8rk, episk, komisk, etc."
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hint GM b\u00f8r s\u00e5 underveis"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Begrensninger \u2013 hva GM b\u00f8r unng\u00e5 eller nekte"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "complete"
      ],
      "default": "draft"
    },
    "play_mode": {
      "type": "string",
      "enum": [
        "digital",
        "physical",
        "hybrid"
      ],
      "default": "digital",
      "description": "Hvordan kampanjen spilles: Digital (skjerm), Fysisk (bord/brikker), Hybrid (begge + skjermvisning)"
    },
    "trashed": {
      "type": "boolean",
      "default": false,
      "description": "Papirkurv \u2013 kampanjen er flyttet til papirkurv og slettes permanent etter 30 dager"
    },
    "trashed_at": {
      "type": "string",
      "format": "date-time",
      "description": "N\u00e5r kampanjen ble flyttet til papirkurv (for 30-dagers nedtelling)"
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "abbr": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "Egendefinerte attributter for regelverket"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "attribute": {
            "type": "string",
            "description": "Knytt til et attributt-navn"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "Egendefinerte ferdigheter"
    },
    "dice_config": {
      "type": "object",
      "properties": {
        "core_dice": {
          "type": "string",
          "description": "f.eks. 1d20, 3d6, 2d10"
        },
        "difficulty_default": {
          "type": "number",
          "description": "Standard DC/vanske"
        },
        "success_threshold": {
          "type": "string",
          "description": "Suksess/fiasco-regler"
        },
        "advantage_rule": {
          "type": "string",
          "description": "Fordel/ulempe-regel"
        }
      },
      "description": "Terningmekanikk for regelverket"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "Spillemoduser (utforsk/kamp/sosial/kvile...)"
    },
    "difficulty": {
      "type": "string",
      "description": "Vanskegrad: lettvint/standard/brutalt \u2013 fritekst"
    }
  },
  "required": [
    "title"
  ]
}