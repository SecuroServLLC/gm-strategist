{
  "name": "Device",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Permanent kode: 4 tegn for terminal, 6 for player, 16 hex for skjermer"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "terminal",
        "player",
        "gamedisplay",
        "game"
      ]
    },
    "label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending"
    },
    "campaign_id": {
      "type": "string"
    },
    "party_member_id": {
      "type": "string",
      "description": "Intern spilltilstand som opprettes automatisk ved karaktervalg"
    },
    "claim_lock": {
      "type": "string"
    },
    "claim_lock_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "device_id",
    "device_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.device_type": {
            "$ne": "terminal"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.device_type": {
            "$ne": "terminal"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.device_type": {
            "$ne": "terminal"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    }
  }
}