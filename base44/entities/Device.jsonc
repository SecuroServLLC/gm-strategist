{
  "name": "Device",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Permanent kode \u2013 4 tegn for terminal, 6 tegn for player, 16 hex for gamedisplay/game"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "terminal",
        "player",
        "gamedisplay",
        "game"
      ],
      "description": "terminal=GM-nettbrett (gamecard, ingen login), player=egen enhet (/joingame, login), gamedisplay=felles skjerm, game=\u00f8kt-hub"
    },
    "label": {
      "type": "string",
      "description": "Egendefinert navn p\u00e5 enheten"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending",
      "description": "pending=venter p\u00e5 GM, active=sluppet inn"
    },
    "campaign_id": {
      "type": "string",
      "description": "Settes n\u00e5r enheten slippes inn / opprettes for en spiller"
    },
    "party_member_id": {
      "type": "string",
      "description": "For terminal/player: hvilken f\u00f8lgesvenn enheten representerer"
    }
  },
  "required": [
    "device_id",
    "device_type"
  ]
}