{
  "name": "TerminalAccess",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Device record ID"
    },
    "access_key": {
      "type": "string",
      "maxLength": 36,
      "description": "Private random access code delivered by the GM's terminal link"
    }
  },
  "required": [
    "device_id",
    "access_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "created_by_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    }
  }
}