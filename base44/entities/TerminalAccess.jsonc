{
  "name": "TerminalAccess",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Device record ID"
    },
    "access_key": {
      "type": "string",
      "maxLength": 36,
      "description": "Private random access code delivered by the GM's terminal link"
    }
  },
  "required": [
    "device_id",
    "access_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}