{
  "name": "Faction",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Forhold til spillerne: Alliert, Fiendtlig, N\u00f8ytral..."
    },
    "power": {
      "type": "number",
      "description": "Makt/innflytelse 0-100",
      "default": 50
    },
    "agenda": {
      "type": "string",
      "description": "Skjult agenda \u2013 fraksjonens egentlige m\u00e5l"
    },
    "description": {
      "type": "string",
      "description": "Hvem fraksjonen er, ressurser, omfang"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Hva fraksjonen gj\u00f8r i bakgrunnen"
    },
    "notes": {
      "type": "string",
      "description": "GM-notater og hendelser"
    }
  },
  "required": [
    "campaign_id",
    "name"
  ]
}